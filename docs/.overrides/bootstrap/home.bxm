    <a class="rv" style="--d:0.30s" href="https://bxplaywright.boxlang.io" target="_blank" rel="noopener noreferrer"><div class="ic"><img src="#variables.basePath#assets/ecosystem/bxplaywright-icon-full.svg" alt="BxPlaywright"></div><b>BxPlaywright <i class="up" aria-hidden="true">&##8599;</i></b><span>Browser automation and testing for BoxLang.</span></a>
    <a class="rv" style="--d:0.35s" href="https://bxlens.boxlang.io" target="_blank" rel="noopener noreferrer"><div class="ic"><img src="#variables.basePath#assets/ecosystem/bxlens-icon-full.svg" alt="BxLens"></div><b>BxLens <i class="up" aria-hidden="true">&##8599;</i></b><span>The debug bar and ops console for BoxLang apps.</span></a>
    <a class="rv" style="--d:0.40s" href="https://bxagents.ai" target="_blank" rel="noopener noreferrer"><div class="ic"><img src="#variables.basePath#assets/ecosystem/bxagents-icon-full.svg" alt="BxAgents"></div><b>BxAgents <i class="up" aria-hidden="true">&##8599;</i></b><span>Build AI agents by convention, powered by BoxLang AI.</span></a>

<!---
	The MatchBox landing page. Selected by docs/index.md's `layout: home`. Head, search-free shell and footer are hand written here;
	the look is matchbox-home.css and the motion is matchbox-home.js. The whole page is hardcoded: index.md's Markdown body is unused.
	Literal `#` is written `##` because this file is interpolated.
--->
<bx:include template="#variables.moduleAssetsDir#/icons.bxm">
<bx:include template="#variables.moduleAssetsDir#/locale-flags.bxm">
<bx:include template="includes/site-helpers.bxm">
<bx:script>
	variables.siteUrl = reReplace( variables.siteConfig.baseURL ?: "https://matchbox.boxlang.io/", "/*$", "/" )
	// The home card is hand designed (tools/og/home.html, rendered to docs/assets/og-home.png). The generated assets/og/home.png still exists for index.md.
	variables.pageTitle = "MatchBox: BoxLang compiled to Rust. Native, WASM, Lambda and ESP32"
	variables.pageDesc = "MatchBox is the Rust runtime for BoxLang. A bytecode VM with a tiered Cranelift JIT that ships to native binaries, the browser, WASI containers, AWS Lambda and ESP32."
	variables.faviconUrl = trim( variables.siteConfig.theme.favicon ?: "" )
</bx:script>
<bx:output>
<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>#encodeForHTML( variables.pageTitle )#</title>
	<meta name="description" content="#encodeForHTML( variables.pageDesc )#">
	<meta name="theme-color" content="##06141a">
	<meta name="robots" content="index, follow, max-image-preview:large">
	<link rel="canonical" href="#variables.siteUrl#">
	<meta property="og:type" content="website">
	<meta property="og:site_name" content="MatchBox">
	<meta property="og:title" content="#encodeForHTML( variables.pageTitle )#">
	<meta property="og:description" content="#encodeForHTML( variables.pageDesc )#">
	<meta property="og:url" content="#variables.siteUrl#">
	<meta property="og:image" content="#variables.siteUrl#assets/og-home.png">
	<meta property="og:image:alt" content="MatchBox: BoxLang, compiled to Rust. Ships to a native binary, the browser, WASI, AWS Lambda and ESP32.">
	<meta property="og:image:width" content="1200">
	<meta property="og:image:height" content="630">
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:site" content="@TryBoxLang">
	<meta name="twitter:title" content="#encodeForHTML( variables.pageTitle )#">
	<meta name="twitter:description" content="#encodeForHTML( variables.pageDesc )#">
	<meta name="twitter:image" content="#variables.siteUrl#assets/og-home.png">
	<bx:if len( variables.faviconUrl )>
		<link rel="icon" href="#resolveAssetUrl( variables.faviconUrl )#">
	</bx:if>
	<script>
		( function () {
			var stored = null;
			try { stored = localStorage.getItem( "bxsites-theme" ); } catch ( e ) {}
			var dark = stored ? stored === "dark" : window.matchMedia( "(prefers-color-scheme: dark)" ).matches;
			document.documentElement.setAttribute( "data-theme", dark ? "dark" : "light" );
		} )();
	</script>
	<link rel="stylesheet" href="#themeAssetUrl( 'matchbox-home.css' )#">
	#renderExtraCss( variables.siteConfig.extraCss ?: [] )#
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@graph": [
			{
				"@type": "SoftwareApplication",
				"name": "MatchBox",
				"applicationCategory": "DeveloperApplication",
				"operatingSystem": "Linux, macOS, Windows",
				"description": "#encodeForJavaScript( variables.pageDesc )#",
				"url": "#variables.siteUrl#",
				"license": "https://www.apache.org/licenses/LICENSE-2.0",
				"codeRepository": "https://github.com/ortus-boxlang/matchbox",
				"programmingLanguage": "BoxLang",
				"offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
				"author": { "@type": "Organization", "name": "Ortus Solutions, Corp", "url": "https://www.ortussolutions.com" }
			},
			{
				"@type": "WebSite",
				"name": "MatchBox",
				"url": "#variables.siteUrl#",
				"publisher": { "@type": "Organization", "name": "Ortus Solutions, Corp", "url": "https://www.ortussolutions.com" }
			},
			{
				"@type": "FAQPage",
				"mainEntity": [
					{ "@type": "Question", "name": "What is MatchBox?", "acceptedAnswer": { "@type": "Answer", "text": "MatchBox is a Rust implementation of the BoxLang runtime. BoxLang is the platform, with a JVM runtime and a Rust runtime. MatchBox compiles BoxLang to bytecode and runs it on a Rust VM with a tiered JIT in the native CLI." } },
					{ "@type": "Question", "name": "Is MatchBox a replacement for BoxLang on the JVM?", "acceptedAnswer": { "@type": "Answer", "text": "No. It complements it. Use the JVM runtime for the full Java ecosystem and broad module coverage, and MatchBox to run BoxLang where a JVM does not fit, such as single binaries, the browser, WASI containers, serverless and microcontrollers." } },
					{ "@type": "Question", "name": "Does MatchBox need a JVM?", "acceptedAnswer": { "@type": "Answer", "text": "No, not for the core runtime or native builds. Experimental Java interop exists in native builds and needs a JDK." } },
					{ "@type": "Question", "name": "Where can MatchBox run?", "acceptedAnswer": { "@type": "Answer", "text": "Native executables, the browser and JavaScript including Cloudflare Workers, WASI containers, AWS Lambda (preview) and ESP32 devices." } },
					{ "@type": "Question", "name": "How do I install MatchBox?", "acceptedAnswer": { "@type": "Answer", "text": "Install MVM, the MatchBox Version Manager, then run mvm install latest and mvm use latest." } },
					{ "@type": "Question", "name": "Can AI agents write MatchBox code?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Install the BoxLang skills with npx skills add ortus-boxlang/skills so your agent learns the targets, commands and limits." } }
				]
			}
		]
	}
	</script>
</head>
<body class="mxh" data-base="#variables.basePath#">
<a class="skip" href="##main">Skip to content</a>

<bx:include template="includes/mx-nav.bxm">

<main id="main">
<header class="hero" id="top"><div class="spot" id="spot"></div>
  <div class="glyphs" aria-hidden="true"></div>
  <div class="wrap grid">
    <div>
      <span class="eyebrow">The Rust runtime for BoxLang</span>
      <h1>BoxLang, <span class="grad">compiled to Rust.</span><br>Ships to <span class="grad swap" id="swap">a native binary</span>.</h1>
      <p class="lede">BoxLang is the platform, and MatchBox is its <b>Rust runtime</b>, alongside the JVM one. Same language, with a bytecode VM and a <b>tiered Cranelift JIT</b>, for <b>native, browser, WASI, AWS Lambda and ESP32</b>.</p>
      <div class="cta"><a class="btn p" href="##install">Install MatchBox &rarr;</a><a class="btn" href="##targets">See where it runs</a><a class="btn" href="##live">Try it live</a></div>
      <div class="install"><code><span class="pr">$</span> curl -fsSL https://raw.githubusercontent.com/ortus-boxlang/matchbox-quick-installer/main/install/install.sh | bash</code><button type="button" data-copy="curl -fsSL https://raw.githubusercontent.com/ortus-boxlang/matchbox-quick-installer/main/install/install.sh | bash">Copy</button></div>
      <div class="chips"><span class="chip"><b>5</b> deployment targets</span><span class="chip"><b>4</b> JIT tiers</span><span class="chip"><b>500+</b> transferred compat tests</span><span class="chip"><b>~500 KB</b> runner stub</span></div>
    </div>
    <div class="term rv" aria-label="MatchBox command line demo">
      <div class="bar"><i class="dot" style="background:##ff5f56"></i><i class="dot" style="background:##ffbd2e"></i><i class="dot" style="background:##27c93f"></i><span style="margin-left:8px">hello.bxs</span></div>
      <div class="tabs" role="tablist" id="ttabs"></div>
      <pre id="tout" aria-live="polite"></pre>
      <div class="sizebar"><span id="sizelbl">runner stub + your bytecode</span><div class="track"><div class="fill" id="sizefill"></div></div></div>
    </div>
  </div>
</header>

<div class="marq" aria-hidden="true"><div class="row" id="marq"></div></div>

<section id="live"><div class="wrap">
	<div class="sh rv"><span class="eyebrow">Try it live</span><h2>MatchBox, <span class="grad">running in this tab</span>.</h2><p>No install and no server. This is a real MatchBox VM compiled to WebAssembly. Click an example or type your own BoxLang.</p></div>
	<div class="mini rv" id="mini">
		<div class="mini-chips" role="group" aria-label="Examples">
			<button type="button" class="mini-chip" data-code="[1, 2, 3].map( n =&gt; n * n )" disabled>map</button>
			<button type="button" class="mini-chip" data-code="arrayReduce( [1, 2, 3, 4], ( sum, n ) =&gt; sum + n, 0 )" disabled>reduce</button>
			<button type="button" class="mini-chip" data-code="&quot;matchbox&quot;.ucase()" disabled>string</button>
			<button type="button" class="mini-chip" data-code="runAsync( () =&gt; 21 * 2 ).get()" disabled>fibers</button>
			<button type="button" class="mini-chip mini-clear" id="mini-clear" title="Clear the output. Session variables are kept.">Clear</button>
		</div>
		<div class="mini-term">
			<div id="mini-out" class="mini-out" role="log" aria-label="MatchBox output" aria-live="polite" tabindex="0"><div class="mini-info">Pick an example, or type an expression below.</div></div>
			<form id="mini-form" class="mini-form"><label for="mini-input"><span aria-hidden="true">bx&gt;</span><span class="sr-only">BoxLang expression</span></label><input id="mini-input" type="text" placeholder="Try 6 * 7" autocomplete="off" spellcheck="false" autocapitalize="off" maxlength="2000" readonly></form>
		</div>
		<div class="mini-foot"><span id="mini-status">The runtime loads when you scroll here.</span><a href="#variables.basePath#playground/">Open the full playground &rarr;</a></div>
	</div>
</div></section>

<section id="why"><div class="wrap">
  <div class="sh rv"><span class="eyebrow">One platform, two runtimes</span><h2>BoxLang on the JVM. <span class="grad">BoxLang on Rust.</span></h2><p>MatchBox does not replace the JVM runtime. It complements it. Write BoxLang once, then choose the runtime that fits where the code has to run.</p></div>
  <div class="plat rv" id="plat">
    <div class="pbar"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/></svg><b>BoxLang</b><span>the language, conventions and tools</span></div>
    <div class="beams" aria-hidden="true"><i></i><i></i></div>
    <div class="rts">
      <div class="rt jvm"><small>RUNTIME A</small><h3>BoxLang on the JVM</h3><p>The full Java ecosystem, broad module coverage, and the infrastructure your JVM apps already use.</p><span class="pick">Choose it for Java interop and the full library surface</span></div>
      <div class="rt rs"><small>RUNTIME B</small><h3>MatchBox, on Rust</h3><p>Single binaries, browser and edge, containers, serverless and microcontrollers, with no JVM at runtime.</p><span class="pick">Choose it to run BoxLang where a JVM does not fit</span></div>
    </div>
  </div>
  <div class="stats" style="margin-top:28px">
    <div class="stat rv"><b class="grad" data-count="5">0</b><span>deployment targets</span><small>native · browser · WASI · Lambda · ESP32</small></div>
    <div class="stat rv" style="--d:.08s"><b class="grad" data-count="4">0</b><span>JIT tiers</span><small>loops, arrays, hot functions</small></div>
    <div class="stat rv" style="--d:.16s"><b class="grad" data-count="500" data-plus="1">0</b><span>transferred compat tests</span><small>black-box, from the BoxLang JVM suite</small></div>
    <div class="stat rv" style="--d:.24s"><b class="grad">0 JVMs</b><span>needed at runtime</span><small>core runtime, native builds</small></div>
  </div>
  <p class="fn">MatchBox is an independent, evolving implementation. Runtime APIs and module support differ between the two, so check compatibility for your target.</p>
</div></section>

<section id="ai"><div class="wrap">
  <div class="sh rv"><span class="eyebrow">AI native</span><h2>Agents already <span class="grad">speak MatchBox</span>.</h2><p>MatchBox is part of the BoxLang productivity platform, where developers and AI agents work in the same loop. Install the skills once and your agent knows the targets, the commands and the limits.</p></div>
  <div class="aig rv">
    <div class="chat" aria-label="An AI agent using MatchBox skills">
      <div class="cbar"><i class="dot" style="background:##ff5f56"></i><i class="dot" style="background:##ffbd2e"></i><i class="dot" style="background:##27c93f"></i><span>your coding agent</span></div>
      <div class="cbody" id="cbody"></div>
    </div>
    <div class="skl">
      <div class="skcmd"><span class="pr">$</span> npx skills add ortus-boxlang/skills</div>
      <div class="sks" id="sks"></div>
      <div class="skm">
        <div><b data-count="105">0</b><span>BoxLang skills in the registry</span></div>
        <div><b>llms.txt</b><span>and an MCP index on this site</span></div>
      </div>
    </div>
  </div>
</div></section>

<section id="vm" style="background:var(--bg2)"><div class="wrap">
  <div class="sh rv"><span class="eyebrow">Inside MatchBox</span><h2>From source to <span class="grad">machine code</span>.</h2><p>Your BoxLang compiles to bytecode. A Rust VM runs it, schedules fibers, and the native CLI compiles hot code with Cranelift.</p></div>
  <div class="vmp rv" id="vmpipe">
    <div class="rail"><i id="vmdot"></i></div>
    <ol id="vmstages"></ol>
    <div class="vmcap"><span class="lbl" id="vmlbl"></span><pre id="vmcode"></pre></div>
  </div>
</div></section>

<section id="jit"><div class="wrap">
  <div class="sh rv"><span class="eyebrow">Speed</span><h2>It watches your code, then <span class="grad">compiles what is hot</span>.</h2><p>Four tiers of JIT, built on Cranelift. Cheap profiling first, native machine code only once a loop or function has earned it.</p></div>
  <div class="jit">
    <div class="tiers rv" id="tiers" role="tablist"></div>
    <div class="jv rv">
      <div class="lbl">Tier in action <span class="ill">ILLUSTRATIVE</span></div>
      <pre id="jcode"></pre>
      <div class="lane">
        <div class="rowb"><em>interpreter</em><div class="pipe"><i id="pi"></i></div><span id="pit">0 ms</span></div>
        <div class="rowb"><em>JIT</em><div class="pipe"><i class="fast" id="pj"></i></div><span id="pjt">0 ms</span></div>
      </div>
    </div>
  </div>
</div></section>

<section id="fibers"><div class="wrap">
  <div class="sh rv"><span class="eyebrow">Concurrency</span><h2>Fibers share one thread, <span class="grad">politely</span>.</h2><p>runAsync, sleep and HTTP yield to a cooperative scheduler, so other fibers keep running while one waits.</p></div>
  <div class="fib rv" id="fib">
    <div class="fl"><em>main</em><div class="ft" data-f="m"></div></div>
    <div class="fl"><em>runAsync A</em><div class="ft" data-f="a"></div></div>
    <div class="fl"><em>runAsync B</em><div class="ft" data-f="b"></div></div>
    <div class="fl one"><em>one thread</em><div class="ft" data-f="t"></div></div>
    <div class="play" id="fplay"></div>
  </div>
</div></section>

<section style="background:var(--bg2)" id="how"><div class="wrap">
  <div class="sh rv"><span class="eyebrow">How it ships</span><h2>A tiny runtime, <span class="grad">plus your code</span>. One file.</h2><p>MatchBox compiles your BoxLang to bytecode and appends it to a stripped runner stub. Nothing else to install on the destination.</p></div>
  <div class="pack rv" id="pack" aria-label="Runner stub plus bytecode makes one executable">
    <div class="blk stub"><b>Runner stub</b><span>VM core, ~500 KB</span></div>
    <div class="plus" aria-hidden="true">+</div>
    <div class="blk code"><b>Your bytecode</b><span>from app.bxs</span></div>
    <div class="plus" aria-hidden="true">=</div>
    <div class="blk exe"><b>./app</b><span>one self-contained file</span></div>
  </div>
  <div class="why3">
    <div class="rv"><b>Nothing to install</b><span>The destination needs no JVM and no separate MatchBox install for a native build.</span></div>
    <div class="rv" style="--d:.08s"><b>Compile once</b><span>Ship a <code>.bxb</code> bytecode file to any compatible runner, or strip the source text with <code>--strip-source</code>.</span></div>
    <div class="rv" style="--d:.16s"><b>Fibers built in</b><span>A cooperative scheduler runs <code>runAsync</code> and non-blocking <code>sleep</code> and HTTP without OS thread overhead.</span></div>
    <div class="rv" style="--d:.24s"><b>Written in Rust</b><span>A memory safe implementation, with a tiered JIT where the target allows it.</span></div>
  </div>
</div></section>

<section id="targets"><div class="wrap">
  <div class="sh rv"><span class="eyebrow">Targets</span><h2>Run it <span class="grad">close to the workload</span>.</h2><p>One codebase. Pick the destination at build time.</p></div>
  <div class="cards" id="cards"></div>
</div></section>

<section id="matrix"><div class="wrap">
  <div class="sh rv"><span class="eyebrow">Know before you go</span><h2>What each target <span class="grad">brings with it</span>.</h2><p>Targets share the language, not every capability. Here is the honest picture, straight from the compatibility guide.</p></div>
  <div class="mx rv" id="mx">
    <div class="mh"></div><div class="mh">Native</div><div class="mh">Browser / WASM</div><div class="mh">ESP32</div>
  </div>
  <p class="fn">A high level orientation, not a guarantee for every release or build. Test the artifact on the destination.</p>
</div></section>

<section id="fusion" style="background:var(--bg2)"><div class="wrap">
  <div class="sh rv"><span class="eyebrow">Native Fusion</span><h2>BoxLang, Rust and Java, <span class="grad">in one loop</span>.</h2><p>Call Rust from BoxLang. Let Rust call back into BoxLang. Reach Java classes from a native build. Tap an arrow to see it.</p></div>
  <div class="loop rv">
    <div class="lv">
      <svg viewBox="0 0 640 424" id="lsvg" role="img" aria-label="BoxLang calls Rust, Rust calls back into BoxLang, and BoxLang reaches Java">
        <defs><linearGradient id="gl" x1="0" x2="1"><stop offset="0" stop-color="##00ff78"/><stop offset="1" stop-color="##00dbff"/></linearGradient>
        <filter id="gw"><feGaussianBlur stdDeviation="4" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs>
        <path id="pA" class="lp on" d="M150 292 C196 236 246 168 296 122" />
        <path id="pB" class="lp" d="M268 112 C196 140 118 206 100 270" />
        <path id="pC" class="lp dash" d="M170 336 C270 392 370 392 470 336" />
        <circle class="pk a" r="6"><animateMotion dur="2.6s" repeatCount="indefinite"><mpath href="##pA"/></animateMotion></circle>
        <circle class="pk b" r="6"><animateMotion dur="2.6s" begin="1.3s" repeatCount="indefinite"><mpath href="##pB"/></animateMotion></circle>
        <circle class="pk c" r="6"><animateMotion dur="3.2s" repeatCount="indefinite"><mpath href="##pC"/></animateMotion></circle>
        <g class="nd" transform="translate(320 78)"><circle r="52"/><text y="-2">Rust</text><text y="18" class="sm">native/*.rs</text></g>
        <g class="nd" transform="translate(110 318)"><circle r="52"/><text y="-2">BoxLang</text><text y="18" class="sm">app.bxs</text></g>
        <g class="nd jv" transform="translate(530 318)"><circle r="52"/><text y="-2">Java</text><text y="18" class="sm">via JNI</text></g>
        <text class="ar" x="232" y="226" id="tA">add(10, 20)</text>
        <text class="ar" x="62" y="176" id="tB">callback(n)</text>
        <text class="ar" x="320" y="412" id="tC" text-anchor="middle">java.new(...)</text>
      </svg>
    </div>
    <div class="lc">
      <div class="ltabs" role="tablist" id="ltabs"></div>
      <div class="lcode"><div class="lbar" id="lbar"></div><pre id="lpre"></pre><div class="lnote" id="lnote"></div></div>
    </div>
  </div>
</div></section>

<section id="mvm" style="background:var(--bg2)"><div class="wrap">
  <div class="sh rv"><span class="eyebrow">MVM, the MatchBox Version Manager</span><h2>Any version, <span class="grad">one command</span>.</h2><p>Install stable releases side by side, pin one per project, and follow the rolling snapshot. Every download is checked against its SHA-256 before it replaces anything.</p></div>
  <div class="mvm rv">
    <div class="term"><div class="bar"><i class="dot" style="background:##ff5f56"></i><i class="dot" style="background:##ffbd2e"></i><i class="dot" style="background:##27c93f"></i><span style="margin-left:8px">terminal</span></div><pre id="mvmout" aria-live="polite"></pre></div>
    <div class="mvmf">
      <div><b>Side by side</b><span>Keep several MatchBox versions installed and switch with <code>mvm use</code>.</span></div>
      <div><b>Per project</b><span>Pin a version in <code>.mvmrc</code> and activate it with <code>mvm use</code>.</span></div>
      <div><b>Verified</b><span>SHA-256 checked before install. A failed check leaves your current version intact.</span></div>
      <div><b>Snapshots</b><span><code>mvm install snapshot</code> tracks the rolling build and refreshes only when it changes.</span></div>
      <div class="dog"><b>Built with MatchBox</b><span>MVM is a BoxLang program compiled to a native executable by MatchBox itself.</span></div>
    </div>
  </div>
</div></section>

<section id="eco"><div class="wrap">
  <div class="sh rv"><span class="eyebrow">Part of the BoxLang ecosystem</span><h2>Built for <span class="grad">BoxLang</span>, with <span class="grad">BoxLang</span>.</h2><p>MatchBox is one runtime in a wider platform. These projects work alongside it.</p></div>
  <div class="eco9">
    <a class="rv" style="--d:0.00s" href="https://boxlang.io" target="_blank" rel="noopener noreferrer"><div class="ic"><img src="#variables.basePath#assets/ecosystem/boxlang-icon-full.svg" alt="BoxLang"></div><b>BoxLang <i class="up" aria-hidden="true">&##8599;</i></b><span>The language and the JVM runtime. MatchBox is its Rust sibling.</span></a>
    <a class="rv" style="--d:0.05s" href="https://ai.boxlang.io" target="_blank" rel="noopener noreferrer"><div class="ic"><img src="#variables.basePath#assets/ecosystem/icon-module-bx-ai.svg" alt="BoxLang AI"></div><b>BoxLang AI <i class="up" aria-hidden="true">&##8599;</i></b><span>Models, tools and agents for your apps. Check module support for the runtime you ship.</span></a>
    <a class="rv" style="--d:0.10s" href="https://boxlang.io/plans" target="_blank" rel="noopener noreferrer"><div class="ic ph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.4 2.2 3.2-.4.9 3.1 2.8 1.7-1.2 3 1.2 3-2.8 1.7-.9 3.1-3.2-.4L12 21l-2.4-2.2-3.2.4-.9-3.1L2.7 14.4l1.2-3-1.2-3 2.8-1.7.9-3.1 3.2.4z"/><path d="M8.5 12.2l2.4 2.4 4.6-4.8"/></svg></div><b>BoxLang+ <i class="up" aria-hidden="true">&##8599;</i></b><span>Support, modules and the features that run a fleet.</span></a>
    <a class="rv" style="--d:0.15s" href="https://www.coldbox.org" target="_blank" rel="noopener noreferrer"><div class="ic"><img src="#variables.basePath#assets/ecosystem/coldbox-icon-full.svg" alt="ColdBox"></div><b>ColdBox <i class="up" aria-hidden="true">&##8599;</i></b><span>Conventions based MVC. MatchBox's app server uses ColdBox style handlers.</span></a>
    <a class="rv" style="--d:0.20s" href="https://commandbox.ortusbooks.com" target="_blank" rel="noopener noreferrer"><div class="ic"><img src="#variables.basePath#assets/ecosystem/commandbox-icon-full.svg" alt="CommandBox"></div><b>CommandBox <i class="up" aria-hidden="true">&##8599;</i></b><span>The CLI, package manager and server for the JVM runtime.</span></a>

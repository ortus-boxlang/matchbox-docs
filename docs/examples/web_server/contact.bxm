<bx:script>
    message = "Try adding a name to the URL: ?name=YourName";
    if ( structKeyExists( url, "name" ) ) {
        name = replace( url.name, "&", "&amp;", "all" );
        name = replace( name, "<", "&lt;", "all" );
        name = replace( name, ">", "&gt;", "all" );
        message = "Thank you, <strong>" & name & "</strong>! We've received your inquiry.";
    }
</bx:script>
<html>
<head><link rel="stylesheet" href="/styles.css"></head>
<body>
    <nav>
        <a href="/">Home</a>
        <a href="/about.bxm">About</a>
        <a href="/contact.bxm">Contact</a>
    </nav>
    <h1>Contact Us</h1>
    <bx:output><p>#message#</p></bx:output>
    <div class="footer">Session ID: <bx:output>#cookie.MBX_SESSION_ID#</bx:output></div>
</body>
</html>

import models.ISpeakable;

class Dog implements="ISpeakable" {
    property name;
    property sound;
    property breed;

    function init(name, breed) {
        this.name  = name
        this.sound = "Woof"
        this.breed = breed
        return this
    }

    function describe() {
        println("I am " & this.name & " and I make the sound '" & this.sound & "'")
    }

    function speak() {
        println(this.name & " barks: Woof! Woof!")
    }

    function fetch(item) {
        println(this.name & " fetches the " & item & "!")
    }
}

<!---
	The MatchBox playground page. Selected by docs/playground.md's `layout: playground`. The runtime, worker and editor logic live
	in docs/assets/playground/; the look is matchbox-home.css plus matchbox-playground.css. The whole page is hardcoded here.
	Literal `#` is written `##` because this file is interpolated.
--->
<bx:include template="#variables.moduleAssetsDir#/icons.bxm">
<bx:include template="#variables.moduleAssetsDir#/locale-flags.bxm">
<bx:include template="includes/site-helpers.bxm">
<bx:script>
	variables.siteUrl = reReplace( variables.siteConfig.baseURL ?: "https://matchbox.boxlang.io/", "/*$", "/" )
	variables.pageUrl = variables.siteUrl & "playground/"
	variables.pageTitle = "MatchBox Playground: run BoxLang in your browser"
	variables.pageDesc = "Write and run BoxLang in your browser with MatchBox compiled to WebAssembly. Real compiler, real VM, nothing installed, nothing sent to a server."
	variables.faviconUrl = trim( variables.siteConfig.theme.favicon ?: "" )
</bx:script>
<bx:output>
<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>#encodeForHTML( variables.pageTitle )#</title>
	<meta name="description" content="#encodeForHTML( variables.pageDesc )#">
	<meta name="theme-color" content="##06141a">
	<meta name="robots" content="index, follow, max-image-preview:large">
	<link rel="canonical" href="#variables.pageUrl#">
	<meta property="og:type" content="website">
	<meta property="og:site_name" content="MatchBox">
	<meta property="og:title" content="#encodeForHTML( variables.pageTitle )#">
	<meta property="og:description" content="#encodeForHTML( variables.pageDesc )#">
	<meta property="og:url" content="#variables.pageUrl#">
	<meta property="og:image" content="#variables.siteUrl#assets/og/home.png">
	<meta property="og:image:width" content="1200">
	<meta property="og:image:height" content="630">
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:site" content="@TryBoxLang">
	<meta name="twitter:title" content="#encodeForHTML( variables.pageTitle )#">
	<meta name="twitter:description" content="#encodeForHTML( variables.pageDesc )#">
	<meta name="twitter:image" content="#variables.siteUrl#assets/og/home.png">
	<bx:if len( variables.faviconUrl )>
		<link rel="icon" href="#resolveAssetUrl( variables.faviconUrl )#">
	</bx:if>
	<script>
		( function () {
			var stored = null;
			try { stored = localStorage.getItem( "bxsites-theme" ); } catch ( e ) {}
			var dark = stored ? stored === "dark" : window.matchMedia( "(prefers-color-scheme: dark)" ).matches;
			document.documentElement.setAttribute( "data-theme", dark ? "dark" : "light" );
		} )();
	</script>
	<link rel="stylesheet" href="#themeAssetUrl( 'matchbox-home.css' )#">
	<link rel="stylesheet" href="#themeAssetUrl( 'matchbox-playground.css' )#">
	#renderExtraCss( variables.siteConfig.extraCss ?: [] )#
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "WebApplication",
		"name": "MatchBox Playground",
		"url": "#variables.pageUrl#",
		"applicationCategory": "DeveloperApplication",
		"operatingSystem": "Any, in a modern browser",
		"description": "#encodeForJavaScript( variables.pageDesc )#",
		"offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
		"isPartOf": { "@type": "WebSite", "name": "MatchBox", "url": "#variables.siteUrl#" }
	}
	</script>
</head>
<body class="mxh pgpage" data-base="#variables.basePath#">
<a class="skip" href="##main">Skip to content</a>
<bx:include template="includes/mx-nav.bxm">
<main id="main">
<header class="pg-hero"><div class="wrap">
	<span class="eyebrow"><span class="pg-dot"></span> BoxLang in WebAssembly</span>
	<h1>A little code. <span class="grad">A live runtime.</span></h1>
	<p class="pg-lede">No install and no JVM. This is MatchBox, the Rust runtime for BoxLang, running in your browser. Pick a demo, change something, see what happens.</p>
	<div class="pg-meta"><span class="pg-badge" id="runtime-status" data-state="loading" role="status">Loading WebAssembly...</span><span>Real compiler. Real VM. Runs on your device.</span><a href="#variables.basePath#building-and-deploying/javascript-and-wasm/">How browser builds work &##8599;</a></div>
</div></header>

<noscript><div class="wrap"><p class="pg-noscript"><strong>This playground needs JavaScript and WebAssembly.</strong> You can still <a href="#variables.basePath#getting-started/quick-start/">run these ideas with the MatchBox CLI</a>.</p></div></noscript>

<section class="pg-demos"><div class="wrap">
	<div class="pg-demohead"><h2>Start with a spark.</h2><span>Six small experiments. Make them your own.</span></div>
	<div id="demo-list" class="demo-list"></div>
	<p id="demo-description" class="pg-demodesc">Functions, interpolation, and a little introduction. Change the name and make it yours.</p>
</div></section>

<section class="pg-bench"><div class="wrap">
	<div class="workbench">
		<div class="wb-toolbar"><div class="wb-left"><span class="wb-label">MATCHBOX PLAYGROUND</span><span class="wb-version" id="runtime-version" title="The MatchBox version compiled into this runtime">MatchBox</span></div><div class="wb-controls"><button type="button" id="clear-console" class="btn sm" title="Clear the console output">Clear</button><button type="button" id="stop-code" class="btn sm" disabled>Stop</button><button type="button" id="run-code" class="btn p sm" disabled>Run script <kbd id="run-shortcut">Ctrl &##8629;</kbd></button></div></div>
		<div class="wb-panels">
			<section class="editor-pane" aria-labelledby="source-title">
				<div class="pane-head"><h2 id="source-title"><label for="source-code">Source</label></h2><span id="source-filename">hello.bxs</span></div>
				<div class="editor-body"><div id="line-numbers" aria-hidden="true"></div><div class="code-wrap"><div id="cur-line" aria-hidden="true"></div><pre id="code-hl" aria-hidden="true"><code></code></pre><textarea id="source-code" aria-describedby="editor-help" spellcheck="false" autocapitalize="off" autocomplete="off" wrap="off" maxlength="65536"></textarea></div></div>
				<div class="pane-foot" id="editor-help"><span>BoxLang &middot; UTF-8</span><span>Ctrl / &##8984; + Enter to run</span></div>
			</section>
			<section class="console-pane" aria-labelledby="console-title">
				<div class="pane-head"><h2 id="console-title">Session console</h2><div><button type="button" class="console-action" id="reset-session" disabled>Reset session</button></div></div>
				<div id="console-output" class="console-output" role="log" aria-label="MatchBox output" aria-live="polite" aria-relevant="additions" tabindex="0"><p class="console-welcome">Your next idea starts here.<br><span>Run a script, or enter an expression below.</span></p></div>
				<form id="repl-form" class="repl-form"><label for="repl-input"><span aria-hidden="true">bx&gt;</span><span class="sr-only">BoxLang expression</span></label><input id="repl-input" type="text" placeholder="Try 1 + 2" autocomplete="off" spellcheck="false" autocapitalize="off" maxlength="65536" aria-describedby="repl-help" readonly><button type="submit" id="repl-submit" aria-label="Evaluate expression" disabled>&##8629;</button></form>
				<div class="pane-foot" id="repl-help"><span>Enter to evaluate &middot; &##8593; &##8595; history</span><span>Stateful REPL</span></div>
			</section>
		</div>
		<div class="wb-foot"><p id="execution-status" role="status">Getting the runtime ready...</p><span>POWERED BY RUST + WASM</span></div>
	</div>
	<p class="pg-hint">Keep exploring: after running this demo, try <code id="demo-hint">greet("your name")</code> in the console.</p>
</div></section>

<section class="pg-notes"><div class="wrap">
	<div class="pg-card"><small>01 / A REAL SESSION</small><h3>Write. Run. Repeat.</h3><p>The editor and the console share variables, functions and objects. Clear only removes output. Reset session starts a fresh VM, and so does choosing another demo.</p></div>
	<div class="pg-card"><small>02 / YOUR BROWSER, YOUR CODE</small><h3>Local by design.</h3><p>Code is compiled and run on your device, not sent to a server. Edits and sessions are not saved when you reload, so copy anything you want to keep.</p></div>
	<div class="pg-card"><small>03 / ROOM TO EXPERIMENT</small><h3>Small, on purpose.</h3><p>Runs stop after 5 seconds, with 128 MiB of memory and 64 KiB limits on source and output. There are no files, network, DOM, JVM APIs or JIT here. <a href="#variables.basePath#differences-from-boxlang/">See target differences &rarr;</a></p></div>
</div></section>

<section class="pg-next"><div class="wrap"><p>Like what you can do in a tab? <strong>Take it to your terminal.</strong></p><a class="btn p" href="#variables.basePath#getting-started/quick-start/">Build with MatchBox &rarr;</a></div></section>
</main>
<bx:include template="includes/mx-foot.bxm">
<script type="module" src="#variables.basePath#assets/playground/playground.js"></script>
</body>
</html>
</bx:output>
